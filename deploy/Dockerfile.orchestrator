# ==============================================================================
# OpenWiki Orchestrator (Unit 1) 生产级 Dockerfile
# 说明：基于 Node.js 22 镜像，在容器内部使用命令全局安装 openwiki CLI，
#       不引入本地源码打包。
# ==============================================================================

FROM node:22-bookworm-slim

# 设置工作目录
WORKDIR /app

# 安装必要的系统依赖 (git, sqlite3, logrotate, curl, ca-certificates)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    sqlite3 \
    logrotate \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 全局安装 openwiki CLI (不包含本地源码)
RUN npm install -g openwiki

# 创建有状态数据目录 (Volume 挂载点)
# /data/openwiki/repos  : Git 仓库目录
# /data/openwiki/static : 导出的静态 Wiki HTML/JS 页面
# /data/openwiki/db     : SQLite 数据库存放目录
# /data/openwiki/logs   : 日志存储目录
RUN mkdir -p /data/openwiki/repos \
             /data/openwiki/static \
             /data/openwiki/db \
             /data/openwiki/logs \
             /app/scripts \
             /app/dist \
             /app/assets/vendor

# 从发布包复制二进制与依赖资源
ARG TARGETARCH
COPY bin/${TARGETARCH:-arm}/orchestrator /app/orchestrator
COPY bin/${TARGETARCH:-arm}/scripts/ /app/scripts/
COPY bin/${TARGETARCH:-arm}/dist/ /app/dist/
COPY bin/${TARGETARCH:-arm}/assets/vendor/ /app/assets/vendor/
COPY bin/${TARGETARCH:-arm}/config.json /app/config.json

# 赋予可执行权限
RUN chmod +x /app/orchestrator /app/scripts/*.sh 2>/dev/null || true

# 声明对外端口
EXPOSE 3000

# 声明持久化卷
VOLUME ["/data/openwiki/repos", "/data/openwiki/static", "/data/openwiki/db", "/data/openwiki/logs"]

# 容器启动命令
ENTRYPOINT ["/app/orchestrator", "-config", "/app/config.json"]
